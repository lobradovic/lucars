@{ViewData["Title"]="Pregled klasa";}
@model List<Klasa>


<h1>Sve klase</h1>

<table>
    <thead>
        <th>ID</th>
        <th>Naziv</th>
        <th colspan="2">Opcije</th>
    </thead>
    <tbody>
        @foreach(var k in Model)
        {
            <tr>
                <td>@k.klasaID</td>
                <td>@k.nazivKlase</td>
                <td><a href="">Update</a></td>
                <td><a href="">Delete</a></td>
            </tr>
        }
    </tbody>
</table>
