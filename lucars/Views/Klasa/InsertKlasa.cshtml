@{ViewData["Title"]="Insert klase";}
@model Klasa

<h1>Unos nove klase</h1>
<div class="navigation"><a asp-controller="Klasa" asp-action="Index" class="abtn"> Nazad</a></div>

<div class="form">
    <form asp-action="InsertKlasa" asp-controller="Klasa" method="POST">
        <div class="formField">
            <label for="">Naziv klase:</label>
            <input type="text" asp-for="@Model.nazivKlase">
            <button type="submit">Potvrdi</button>
        </div>
    </form>
</div>