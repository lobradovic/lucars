<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LUCARS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lucars.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="headerDiv">
            <div class="headerLogo"><img src="~/images/lucarsWhite.png" alt=""></div>
            <div class="headerNav">
                <nav>
                    <a href="">Home</a>
                    <a href="">Booking</a>
                    <a href="">Admin</a>
                    <a asp-controller="Account" asp-action="Logout">Logout</a>
                </nav>
            </div>
        </div>
    </header>
    <div class="container">
            @RenderBody()
    </div>

<footer class="foot">
    <div class="footCol"><a href=""><img src="~/images/obradovicWhite.png" alt="Logo" /></a></div>
    <div class="footCol">
        <h3>Useful pages</h3>
        <a href="/">Home</a>
        <a href="https://raf.edu.rs/">RAF</a>
        <a href="https://github.com/lobradovic/lucars">Github</a>
    </div>
    <div class="footCol">
        <h3>About me</h3>
        <a href="">Linkedin</a>
        <a href="">Github</a>
        <a href="">Instagram</a>
    </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
