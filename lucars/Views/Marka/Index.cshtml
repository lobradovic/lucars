@{
   ViewData["Title"] ="Marke";
}
@model List<Marka>

<h1>Prikaz svih marki</h1>
<div class="navigation"><a asp-controller="Admin" asp-action="Index" class="abtn"> Nazad</a></div>

<a asp-controller="Marka" asp-action="InsertMarka" class="abtn">Unos nove marke</a>
<table id="klijentska">
    <thead>
        <tr>
        <th>ID</th>
        <th>Naziv</th>
        <th>Update</th>
        <th>Delete</th>
        </tr>
    </thead>
<tbody>
        @foreach(var m in Model)
        {
            <tr>
                <td>@m.markaID</td>
                <td>@m.nazivMarke</td>
                <td><a asp-controller="Marka" asp-action="UpdateMarka" asp-route-id="@m.markaID" class="abtn">Update</a></td>
                <td>
                    <form asp-action="DeleteMarka" asp-controller="Marka" method="POST" asp-route-id="@m.markaID">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="@m.markaID" />
                        <button class="abtn" type="submit">Obriši</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#klijentska').DataTable();
        });
    </script>
}