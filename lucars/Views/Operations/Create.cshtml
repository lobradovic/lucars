@model User
@{Layout=null;}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Strong_eCourses</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Strong_eCourses.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div asp-validation-summary="All"></div>
  <div class="reg">
        <div class="loginDiv">
            <div class="regLogo">
                <img src="~/images/lucarsWhite.png" alt="Logo">
    
            </div>
            <div class="welcomeDiv">
                <h2>Dobro došli!</h2>
                <p>Molimo kreirajte korisnički nalog</p>
            </div>
            <form action="" method="POST">
            <div class="form">
                <div class="formField inp">
                    <label asp-for="Name">Korisničko ime:</label>
                    <input asp-for="Name" type="text">
                </div>
                <div class="formField inp">
                    <label asp-for="Email">E-mail</label>
                    <input asp-for="Email" type="text">
                </div>
                <div class="formField inp">
                    <label asp-for="Password">Lozinka</label>
                    <input asp-for="Password" type="password">
                </div>
                <div class="formField submitBtn">
                    <button type="submit">Potvrdi</button>
                </div>
                <div class="formField formNote">
                    <p>Imate nalog? <a asp-controller="Account" asp-action="Login" >Ulogujte se</a></p>
                </div>     
            </div>
            </form>
        </div>
        <div class="hero-content">
            <h1>Pridruži se stotinama zadovoljnih vozača uz LUCARS!</h1>
            <p>Naša rent a car agencija nudi pouzdana i moderna vozila za sve tvoje potrebe – bilo da putuješ poslovno, turistički ili ti treba zamensko vozilo.</p>
            <ul>
                <li>Povoljni dnevni i vikend paketi</li>
                <li>Širok izbor vozila – od ekonomičnih do luksuznih</li>
                <li>Jednostavna online rezervacija</li>
                <li>Osiguranje i podrška 24/7</li>
            </ul>
            <p>Rezerviši vozilo danas i vozi bez brige uz LUCARS!</p>
            <a class="formField" asp-controller="Home" asp-action="Index">Početna strana</a>
        </div>
       
    </div>
    </div>
</body>
</html>