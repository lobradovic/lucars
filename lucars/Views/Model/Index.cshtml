@{ViewData["Title"]="Svi modeli";}
@model List<Model>

<h1>Svi modeli</h1>
<div class="navigation"><a asp-controller="Admin" asp-action="Index" class="abtn"> Nazad</a></div>

<a asp-controller="Model" asp-action="InsertModel" class="abtn">Unos novog modela</a>
<table id="klijentska">
    <thead>
        <tr>
        <th>ID</th>
        <th>Marka</th>
        <th>Model</th>
        <th>Update</th>
        <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var m in Model)
        {
            <tr>
                <td>@m.modelID</td>
                <td>@m.Markas.nazivMarke</td>
                <td>@m.nazivModela</td>
                <td><a asp-controller="Model" asp-action="UpdateModel" asp-route-id="@m.modelID" class="abtn">Update</a></td>
                <td>
                    <form asp-action="DeleteModel" asp-controller="Model" method="POST" asp-route-id="@m.modelID">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="@m.modelID" />
                        <button class="abtn" type="submit">Obriši</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#klijentska').DataTable();
        });
    </script>
}