@{
    ViewData["Title"] = "LUCARS - Homepage";
}
@model AutoPageModel
<div>
<div class="searchDiv">
        <form method="GET">
            <input type="text" name="searchQuery" value="@Model.searchQuery" placeholder="Pretraži automobile" />
        @* 
            <select name="selectedCategory" class="form-select">
                <option value="">Sve kategorije</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(category == Model.SelectedCategory ? "selected" : null)">@category</option>
                }
            </select> *@

            <button type="submit">Filtriraj</button>
        </form>
    </div>
</div>
    <div class="automobili">
        @foreach(var automobil in Model.automobili)
        {
            
            <div class="automobil">
            <a asp-controller="Booking" asp-action="Index" asp-route-id="@automobil.automobilID">
            <h2>@automobil.Model.Markas.nazivMarke @automobil.Model.nazivModela</h2>
            <p>@automobil.godinaProizvodnje</p>
            <p>@automobil.Klasa.nazivKlase</p>
            <p>@automobil.cena EUR</p>
            </a>
            </div>
            
        }
    </div>
    <div class="pagination"></div>
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a asp-action="Index" asp-route-page="@i" asp-route-searchQuery="@Model.searchQuery"
           class="@(i == Model.CurrentPage ? "active" : "")">
            @i
        </a>
    }
</div>
</div>
